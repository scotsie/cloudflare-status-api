{
        'author': 'Scotsie (mscottcrace@gmail.com)',
        'description': 'Monitor the Cloudflare Services through their public API. '
                       'Will discover all services filtering on group = "True" '
                       'or the top level services where group_id = "1km35smx8p41". '
                       'Status will be checked and OK for operational, WARN for '
                       '"degraded" or "partial outages" and CRIT for "major outages" '
                       'or any other currently unidentified state.'
                       'For sites with subcomponents, the details will contain the '
                       'subcomponent(s) name and current status.',
         'download_url': 'https://github.com/scotsie/cloudflare-status-api',
         'files': {
                'cmk_addons_plugins': [
                        'cloudflare-status-api/agent_based/cloudflare_status_api.py',
                        'cloudflare-status-api/checkman/cloudflare_status_api',
                        'cloudflare-status-api/libexec/agent_cloudflare_status_api',
                        'cloudflare-status-api/rulesets/cloudflare_status_api_register.py',
                        'cloudflare-status-api/server_side_calls/agent_cloudflare_status_api.py']},
        'name': 'cloudflare_status_api',
        'title': 'Cloudflare Status API Special Agent',
        'version': '2.3.2',
        'version.min_required': '2.3.0p12',
        'version.packaged': '2.3.0p19',
        'version.usable_until': '2.5.0'
}