{
        'author': 'Scotsie (mscottcrace@gmail.com)',
        'description': 'Monitor the Cloudflare Services through their public API. '
                       'By default, discovers one service per group (e.g. '
                       '"Europe"). The "Cloudflare Status API discovery" ruleset '
                       'can disable grouping and filter by name to discover '
                       'individual datacenters/components instead. '
                       'Status will be checked and OK for operational, WARN for '
                       '"degraded", "partial outages" or "under maintenance" and '
                       'CRIT for "major outages" or any other currently '
                       'unidentified state. '
                       'For sites with subcomponents, the details will contain '
                       'the non-operational subcomponent(s) name and status.',
         'download_url': 'https://github.com/scotsie/cloudflare-status-api',
         'files': {
                'cmk_addons_plugins': [
                        'cloudflare_status_api/agent_based/cloudflare_status_api.py',
                        'cloudflare_status_api/checkman/cloudflare_status_api',
                        'cloudflare_status_api/libexec/agent_cloudflare_status_api',
                        'cloudflare_status_api/rulesets/cloudflare_status_api_register.py',
                        'cloudflare_status_api/server_side_calls/agent_cloudflare_status_api.py']},
        'name': 'cloudflare_status_api',
        'title': 'Cloudflare Status API Special Agent',
        'version': '2.3.4',
        'version.min_required': '2.3.0p12',
        'version.packaged': '2.3.0p19',
        'version.usable_until': None
}